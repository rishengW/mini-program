/* pages/abnormal-list/abnormal-list.wxss */
.page-header { margin-bottom: 20rpx; }
.page-title { font-size: 34rpx; font-weight: 600; }

.filter-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.filter-tab {
  padding: 10rpx 24rpx;
  background: #ffffff;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #595959;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.filter-tab-active {
  background: #00873E;
  color: #ffffff;
}

.abnormal-type {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* 异常类型小圆点：替代彩色 emoji，跨端一致 */
.type-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #BFBFBF;
  flex-shrink: 0;
}
.type-dot-quality { background: #FF4D4F; }
.type-dot-shortage { background: #FAAD14; }
.type-dot-delay { background: #FA8C16; }
.type-dot-wrong_item { background: #5B8FF9; }
.type-name { font-size: 28rpx; font-weight: 600; }

.abnormal-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #595959;
  line-height: 1.6;
}

.abnormal-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8C8C8C;
}

.dot { margin: 0 8rpx; }

.resolution-box {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: #F6FFED;
  border-radius: 8rpx;
}

.item-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #F0F0F0;
}
