/* pages/approval-list/approval-list.wxss */

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.page-title {
  font-size: 34rpx;
  font-weight: 600;
}

.page-count {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.requester-badge {
  display: inline-block;
  background: var(--color-success-bg);
  color: var(--color-primary);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
  margin-right: 8rpx;
}

.item-products {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.product-tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  background: var(--color-bg-grey);
  border-radius: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.item-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.item-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-divider);
}

.manual-badge {
  display: inline-block;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: var(--color-accent-orange);
  border: 1rpx solid var(--color-warning-light);
  background: var(--color-warning-bg);
}
