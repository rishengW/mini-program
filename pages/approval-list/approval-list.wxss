/* pages/approval-list/approval-list.wxss */

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.page-title {
  font-size: 34rpx;
  font-weight: 600;
}

.page-count {
  font-size: 24rpx;
  color: #8C8C8C;
}

.requester-badge {
  display: inline-block;
  background: #E6F7FF;
  color: #1890FF;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
  margin-right: 8rpx;
}

.item-products {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.product-tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  background: #F0F2F5;
  border-radius: 6rpx;
  font-size: 22rpx;
  color: #595959;
}

.item-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8C8C8C;
}

.item-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}
