/* pages/report-detail/report-detail.wxss */

.report-header-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.report-type-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.report-type-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #262626;
  margin-bottom: 6rpx;
}

.report-scope-info {
  font-size: 26rpx;
  color: #595959;
  margin-bottom: 4rpx;
}

.report-date-info {
  font-size: 24rpx;
  color: #8C8C8C;
}

/* 表格 */
.table-header {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #E8E8E8;
  font-size: 24rpx;
  color: #8C8C8C;
  font-weight: 500;
}

.table-row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
  font-size: 26rpx;
  color: #262626;
  align-items: center;
}

.table-row:last-child { border-bottom: none; }

.row-warning { background: #FFFBE6; margin: 0 -28rpx; padding-left: 28rpx; padding-right: 28rpx; }

.table-total {
  display: flex;
  padding: 20rpx 0;
  border-top: 2rpx solid #E8E8E8;
  font-size: 28rpx;
}

.col-name { flex: 3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.col-cat { flex: 2; font-size: 24rpx; color: #8C8C8C; }
.col-unit { flex: 1; text-align: center; }
.col-qty { flex: 1; text-align: right; }
.col-num { flex: 1.2; text-align: center; }
.col-amount { flex: 1.5; text-align: right; }
.col-store { flex: 2; }

/* 导出 */
.export-section {
  padding: 32rpx 0;
  text-align: center;
}

.export-hint {
  margin-top: 16rpx;
}
