/* pages/report-detail/report-detail.wxss */

.report-header-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--color-white);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.report-type-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.report-type-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 6rpx;
}

.report-scope-info {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 4rpx;
}

.report-date-info {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* 表格 */
.table-header {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--color-border);
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  font-weight: 500;
}

.table-row {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
  font-size: 26rpx;
  color: var(--color-text-primary);
  align-items: center;
}

.table-row:last-child { border-bottom: none; }

.row-warning { background: var(--color-warning-bg-alt); margin: 0 -28rpx; padding-left: 28rpx; padding-right: 28rpx; }

.table-total {
  display: flex;
  padding: 20rpx 0;
  border-top: 2rpx solid var(--color-border);
  font-size: 28rpx;
}

.report-abnormal-banner {
  color: var(--color-danger-dark);
  background: var(--color-danger-bg-alt);
  border: 1rpx solid var(--color-danger-lighter);
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  font-size: 24rpx;
}

.col-name { flex: 3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.col-cat { flex: 2; font-size: 24rpx; color: var(--color-text-tertiary); }
.col-unit { flex: 1; text-align: center; }
.col-qty { flex: 1; text-align: right; }
.col-num { flex: 1.2; text-align: center; }
.col-amount { flex: 1.5; text-align: right; }
.col-store { flex: 2; }

.abnormal-label {
  flex-basis: 100%;
  color: var(--color-danger-dark);
  font-size: 22rpx;
  margin-top: 8rpx;
}

/* 关联采购单跳转入口 */
.report-order-link {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-primary);
}

/* 供应商报表行级跳转：商品名超链接样式 */
.link-text {
  color: var(--color-primary);
  text-decoration: underline;
}

/* 导出 */
.export-section {
  padding: 32rpx 0;
  text-align: center;
}

.export-hint {
  margin-top: 16rpx;
}
