<!-- pages/report-history/report-history.wxml -->
<view class="container">
  <view class="page-header">
    <view class="page-title">历史报表</view>
    <view class="page-subtitle">共 {{total}} 份报表</view>
  </view>

  <!-- 筛选区 -->
  <view class="filter-section">
    <view class="filter-row">
      <picker range="{{scopeOptions}}" range-key="label" bindchange="onScopeChange" style="flex:1;">
        <view class="filter-picker"><view class="icon icon-sm icon-inline icon-folder-grey"></view>{{filterScopeLabel}} ▾</view>
      </picker>
      <picker range="{{reportTypeOptions}}" range-key="label" bindchange="onTypeChange" style="flex:1;">
        <view class="filter-picker"><view class="icon icon-sm icon-inline icon-clipboard-grey"></view>{{filterTypeLabel}} ▾</view>
      </picker>
    </view>
    <view class="filter-row">
      <picker mode="date" bindchange="onDateChange" value="{{filterDate}}" style="flex:1;">
        <view class="filter-picker"><view class="icon icon-sm icon-inline icon-calendar-grey"></view>{{filterDate || '选择日期'}} ▾</view>
      </picker>
      <view wx:if="{{filterDate}}" class="clear-btn" bindtap="clearDate">清除日期</view>
    </view>
  </view>

  <!-- 报表列表 -->
  <view wx:for="{{reports}}" wx:key="reportId" class="list-item" bindtap="goDetail" data-id="{{item.reportId}}">
    <view class="report-row">
      <view class="report-icon" style="background:{{item.typeColor}}20;"><view class="icon {{item.typeIconClass}}"></view></view>
      <view class="report-info">
        <view class="report-name">{{item.typeLabel}}<text wx:if="{{item.statusText && item.status !== 'generated'}}" class="tag tag-{{item.statusType}}" style="margin-left:12rpx;">{{item.statusText}}</text></view>
        <view class="report-meta">{{item.scopeName}} · {{item.relatedDate}}</view>
        <view class="report-version">v{{item.fileVersion}} · {{item.generatedAt}}</view>
      </view>
      <view class="report-arrow">›</view>
    </view>
  </view>

  <view wx:if="{{loadFailed}}" class="empty-state">
    <view class="empty-state-icon icon icon-xxl icon-chart-grey"></view>
    <view class="empty-state-text">加载失败，请检查网络后重试</view>
    <button class="btn btn-primary btn-sm" bindtap="reload" style="margin-top:24rpx;">重新加载</button>
  </view>
  <view wx:elif="{{isLoading && reports.length === 0}}" class="empty-state">
    <view class="empty-state-text">加载中...</view>
  </view>
  <view wx:elif="{{reports.length === 0}}" class="empty-state">
    <view class="empty-state-icon icon icon-xxl icon-chart-grey"></view>
    <view class="empty-state-text">暂无报表</view>
  </view>
  <view wx:if="{{reports.length > 0}}" class="empty-state-text" style="text-align:center;padding:24rpx 0;">
    <text wx:if="{{isLoadingMore}}">加载中...</text>
    <text wx:elif="{{!hasMore}}">没有更多了</text>
    <text wx:else>上拉加载更多</text>
  </view>
</view>
