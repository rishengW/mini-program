/* pages/report-history/report-history.wxss */
.page-header { margin-bottom: 24rpx; }
.page-title { font-size: 36rpx; font-weight: 700; }
.page-subtitle { font-size: 24rpx; color: var(--color-text-tertiary); margin-top: 4rpx; }

.filter-section { margin-bottom: 24rpx; }
.filter-row { display: flex; gap: 12rpx; margin-bottom: 12rpx; align-items: center; }
.filter-picker {
  height: 68rpx; line-height: 68rpx; padding: 0 20rpx;
  background: var(--color-bg-card); border-radius: var(--radius-md);
  font-size: 26rpx; box-shadow: var(--shadow-card); white-space: nowrap; overflow: hidden;
}
.clear-btn {
  font-size: 24rpx; color: var(--color-danger); padding: 0 16rpx;
  height: 68rpx; line-height: 68rpx;
}

.report-row { display: flex; align-items: center; gap: 20rpx; }
.report-icon {
  width: 72rpx; height: 72rpx; border-radius: var(--radius-md);
  display: flex; align-items: center; justify-content: center; font-size: 32rpx; flex-shrink: 0;
}
.report-info { flex: 1; min-width: 0; }
.report-name { font-size: 28rpx; font-weight: 600; }
.report-meta { font-size: 24rpx; color: var(--color-text-secondary); margin-top: 4rpx; }
.report-version { font-size: 22rpx; color: var(--color-text-tertiary); margin-top: 2rpx; }
.report-arrow { font-size: 36rpx; color: var(--color-text-tertiary); flex-shrink: 0; }
