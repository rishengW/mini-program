/* pages/supplier-home/supplier-home.wxss */

.supplier-header {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary-dark));
  border-radius: var(--radius-lg);
  padding: 36rpx 28rpx;
  margin-bottom: 24rpx;
  color: #ffffff;
}

.supplier-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-right: 24rpx;
}

.supplier-name {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.supplier-meta {
  font-size: 24rpx;
  opacity: 0.9;
  line-height: 1.6;
}

/* 首页通知条（新订单下推等站内消息入口） */
.notice-bar {
  display: flex;
  align-items: center;
  background: #FFF7E6;
  border: 1rpx solid #FFE7BA;
  border-radius: var(--radius-lg);
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.notice-bar:active {
  opacity: 0.85;
}

.notice-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.notice-content {
  flex: 1;
  overflow: hidden;
}

.notice-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.notice-badge {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #FF4D4F;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 400;
  text-align: center;
}

.notice-text {
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-card);
}

.stat-card:active {
  opacity: 0.85;
}

.stat-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.stat-label {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
}

.entry-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.entry-item:last-child {
  border-bottom: none;
}

.entry-item:active {
  opacity: 0.85;
}

.entry-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
}

.entry-info {
  flex: 1;
}

.entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.entry-desc {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
}

.entry-arrow {
  color: var(--color-text-placeholder);
  font-size: 32rpx;
}
