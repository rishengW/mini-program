<!-- pages/supplier-home/supplier-home.wxml -->
<view class="container">
  <!-- 供货商信息 -->
  <view class="supplier-header">
    <view class="supplier-avatar">🚚</view>
    <view class="supplier-detail">
      <view class="supplier-name">{{supplierName}}</view>
      <view class="supplier-meta">{{contactName}}<text wx:if="{{contactPhone}}"> · {{contactPhone}}</text></view>
      <view class="supplier-meta">{{userName}} · 供货商</view>
    </view>
  </view>

  <!-- 订单状态统计 -->
  <view class="stats-row">
    <view wx:for="{{stats}}" wx:key="key" class="stat-card" bindtap="goStatPage" data-status="{{item.key}}">
      <view class="stat-icon" style="color:{{item.color}};">{{item.icon}}</view>
      <view class="stat-value">{{item.value}}</view>
      <view class="stat-label">{{item.label}}</view>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="card">
    <view class="card-title">业务功能</view>
    <view class="entry-item" bindtap="goOrders">
      <view class="entry-icon">📋</view>
      <view class="entry-info">
        <view class="entry-title">采购订单</view>
        <view class="entry-desc">查看订单、确认接单、标记发货</view>
      </view>
      <view class="entry-arrow">▸</view>
    </view>
    <view class="entry-item" bindtap="goReceipts">
      <view class="entry-icon">📦</view>
      <view class="entry-info">
        <view class="entry-title">收货记录</view>
        <view class="entry-desc">门店实收数量与金额，用于对账</view>
      </view>
      <view class="entry-arrow">▸</view>
    </view>
    <view class="entry-item" bindtap="goPrices">
      <view class="entry-icon">💰</view>
      <view class="entry-info">
        <view class="entry-title">商品价格</view>
        <view class="entry-desc">当前生效的协议价格</view>
      </view>
      <view class="entry-arrow">▸</view>
    </view>
    <view class="entry-item" bindtap="goAccount">
      <view class="entry-icon">🔒</view>
      <view class="entry-info">
        <view class="entry-title">账号设置</view>
        <view class="entry-desc">修改登录密码</view>
      </view>
      <view class="entry-arrow">▸</view>
    </view>
  </view>

  <button class="btn btn-outline btn-block" style="margin-top: 12rpx;" bindtap="switchAccount">退出登录</button>
</view>
