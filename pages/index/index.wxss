/* pages/index/index.wxss */

.store-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  padding: 32rpx;
  border-radius: var(--radius-lg);
  color: #ffffff;
  margin-bottom: 20rpx;
}
.store-name { font-size: 32rpx; font-weight: 600; display: flex; align-items: center; }
.store-pin { margin-right: 8rpx; }
.user-info { margin-top: 6rpx; color: rgba(255,255,255,0.8); }
.store-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 20rpx;
}
.store-action {
  font-size: 26rpx;
  line-height: 1.4;
  opacity: 0.9;
  white-space: nowrap;
  padding: 10rpx 4rpx;
}
.store-action-icon { margin-right: 6rpx; }
.store-action + .store-action { margin-top: 12rpx; }

/* 退出登录：页底大按钮（加大加高） */
.logout-btn { margin-top: 24rpx; height: 104rpx; line-height: 104rpx; font-size: 32rpx; border-radius: 16rpx; }

/* 未读消息铃铛入口（加大热区，便于点按） */
.bell-entry {
  position: relative;
  margin-bottom: 12rpx;
  align-self: flex-end;
  padding: 10rpx;
}
.bell-icon { width: 64rpx; height: 64rpx; display: block; }
.bell-badge {
  position: absolute;
  top: -10rpx;
  right: -14rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 15rpx;
  background: var(--color-danger);
  color: #ffffff;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
  box-sizing: border-box;
}

/* 数据概览：2×N 大卡片，点击区域宽松 */
.stats-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.stat-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx 16rpx 36rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  transition: transform 0.12s ease, opacity 0.12s ease;
}
.stat-card:active {
  transform: scale(0.96);
  opacity: 0.88;
}
.stat-card .stat-icon { margin: 0 auto; width: 60rpx; height: 60rpx; }
.stat-value { font-size: 56rpx; font-weight: 700; color: var(--color-text-primary); margin: 10rpx 0 4rpx; }
.stat-label { font-size: 28rpx; color: var(--color-text-tertiary); }

/* 快捷操作：2 列大按钮，白卡片 + 阴影 + 按压反馈 */
.action-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}
.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 36rpx 0 32rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  transition: transform 0.12s ease, opacity 0.12s ease;
}
.action-item:active {
  transform: scale(0.96);
  opacity: 0.88;
}
/* 功能图标：浅绿衬底大圆角块 + 品牌绿线性图标，替代 emoji */
.action-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  background: rgba(0, 135, 62, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}
.action-icon .icon { width: 64rpx; height: 64rpx; }
.action-label { font-size: 30rpx; font-weight: 500; color: var(--color-text-primary); margin-top: 16rpx; }

/* 列表 */
.item-meta { margin-top: 8rpx; font-size: 24rpx; color: var(--color-text-tertiary); }
.dot { margin: 0 8rpx; }
.empty-hint { text-align: center; padding: 32rpx 0; color: var(--color-text-placeholder); font-size: 26rpx; }
.more-link { font-size: 24rpx; color: var(--color-primary); }

/* 报表迷你条目 */
.report-mini-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}
.report-mini-item:last-child { border-bottom: none; }
.report-mini-icon { margin-right: 16rpx; }
.report-mini-info { flex: 1; }
.report-mini-title { font-size: 28rpx; font-weight: 500; color: var(--color-text-primary); }
.report-mini-arrow { color: var(--color-text-placeholder); font-size: 24rpx; }

/* 新增门店弹窗 */
.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-content {
  width: 600rpx;
  background: var(--color-bg-card);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  text-align: center;
  margin-bottom: 32rpx;
}
.form-field { margin-bottom: 24rpx; }
.form-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: 12rpx;
}
.form-input {
  border: 2rpx solid #D9D9D9;
  border-radius: var(--radius-md);
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}
.form-hint {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 24rpx;
}
.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}
.modal-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.modal-btn-secondary { background: #F5F5F5; color: var(--color-text-secondary); }
.modal-btn-primary { background: var(--color-primary); color: #ffffff; }
