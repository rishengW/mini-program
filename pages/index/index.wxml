<!-- pages/index/index.wxml -->
<!-- 重写：状态卡片可点击 + 删除快捷操作 -->
<view class="container">
  <!-- 门店 & 用户 -->
  <view class="store-header">
    <view class="store-info" bindtap="goStore">
      <view class="store-name">📍 {{storeName}} <text style="font-size: 24rpx; color: rgba(255,255,255,0.8);">切换 ▸</text></view>
      <view class="user-info text-sm text-tertiary">
        {{userName}} · {{roleLabel}}
      </view>
    </view>
    <view class="store-actions">
      <view class="store-action" bindtap="goAccount">
        <text>🔒 密码设置</text>
      </view>
      <view class="store-action" bindtap="switchAccount">
        <text>🔄 切换账号</text>
      </view>
    </view>
  </view>

  <!-- 管理工作台 -->
  <view wx:if="{{isManager}}" class="card" style="margin-top:-10rpx; margin-bottom:24rpx;">
    <view class="flex-between">
      <view class="card-title">管理工作台</view>
    </view>
    <view class="action-grid" style="grid-template-columns: repeat(4, 1fr);">
      <view class="action-item" bindtap="goAction" data-url="/pages/approval-list/approval-list">
        <view class="action-icon">📝</view>
        <view class="action-label">采购审核</view>
      </view>
      <view class="action-item" bindtap="goAction" data-url="/pages/product-manage/product-manage">
        <view class="action-icon">🥬</view>
        <view class="action-label">商品管理</view>
      </view>
      <view class="action-item" bindtap="goAction" data-url="/pages/supplier-manage/supplier-manage">
        <view class="action-icon">🏭</view>
        <view class="action-label">供应商</view>
      </view>
      <view class="action-item" bindtap="goAction" data-url="/pages/price-manage/price-manage">
        <view class="action-icon">💰</view>
        <view class="action-label">价格管理</view>
      </view>
      <view wx:if="{{isSuperAdmin}}" class="action-item" bindtap="goAction" data-url="/pages/user-manage/user-manage">
        <view class="action-icon">👥</view>
        <view class="action-label">账号管理</view>
      </view>
    </view>
  </view>

  <!-- 数据概览（全部可点击） -->
  <view class="stats-row">
    <view wx:for="{{stats}}" wx:key="label" class="stat-card" bindtap="goStatPage" data-status="{{item.status}}">
      <view class="stat-icon" style="color:{{item.color}};">{{item.icon}}</view>
      <view class="stat-value">{{item.value}}</view>
      <view class="stat-label">{{item.label}}</view>
    </view>
  </view>

  <!-- 快捷操作已删除 -->

  <!-- 最近采购单 -->
  <view class="card">
    <view class="card-title">最近采购单</view>
    <view wx:for="{{recentOrders}}" wx:key="purchaseOrderId" class="list-item" bindtap="goOrderDetail" data-id="{{item.purchaseOrderId}}">
      <view class="flex-between">
        <view class="item-title">
          {{item.orderDate}} 门店采购
          <text wx:if="{{item.manualCount > 0}}" style="font-size:22rpx;color:#FAAD14;"> (含{{item.manualCount}}个手动商品)</text>
        </view>
        <view class="tag tag-{{item.statusType}}">{{item.statusText}}</view>
      </view>
      <view class="item-meta">
        <text>{{item.storeName}}</text>
        <text class="dot">·</text>
        <text>{{item.itemCount}}种商品</text>
        <text class="dot">·</text>
        <text>{{item.createdBy}}</text>
      </view>
    </view>
    <view wx:if="{{recentOrders.length === 0}}" class="empty-hint">暂无采购单</view>
  </view>

  <!-- 最近报表 -->
  <view class="card">
    <view class="flex-between">
      <view class="card-title">最近报表</view>
      <view class="more-link" bindtap="goAction" data-taburl="/pages/report-list/report-list">查看全部 ▸</view>
    </view>
    <view wx:for="{{recentReports}}" wx:key="reportId" class="report-mini-item" bindtap="goReportDetail" data-id="{{item.reportId}}">
      <view class="report-mini-icon" style="color:{{item.typeColor}};">{{item.typeIcon}}</view>
      <view class="report-mini-info">
        <view class="report-mini-title">{{item.typeLabel}}</view>
        <view class="text-sm text-tertiary">{{item.scopeName}} · {{item.relatedDate}}</view>
      </view>
      <view class="report-mini-arrow">▸</view>
    </view>
    <view wx:if="{{recentReports.length === 0}}" class="empty-hint">暂无报表</view>
  </view>
</view>
