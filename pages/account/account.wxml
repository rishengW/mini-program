<!-- pages/account/account.wxml -->
<view class="container account-page">
  <view class="card account-summary">
    <view class="account-avatar">{{avatarText}}</view>
    <view class="account-info">
      <view class="account-name">{{user.name}}</view>
      <view class="account-meta">{{user.username}} · {{user.roleLabel}}</view>
    </view>
  </view>

  <view class="card password-card">
    <view class="card-title">重设登录密码</view>
    <view class="form-group">
      <view class="form-label">当前密码</view>
      <input class="form-input" password value="{{form.currentPassword}}" placeholder="请输入当前密码" bindinput="onInput" data-field="currentPassword" />
    </view>
    <view class="form-group">
      <view class="form-label">新密码</view>
      <input class="form-input" password value="{{form.newPassword}}" placeholder="至少6位" bindinput="onInput" data-field="newPassword" />
    </view>
    <view class="form-group">
      <view class="form-label">确认新密码</view>
      <input class="form-input" password value="{{form.confirmPassword}}" placeholder="请再次输入新密码" bindinput="onInput" data-field="confirmPassword" />
    </view>
    <button class="btn btn-primary btn-block" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">更新密码</button>
    <view class="password-tip">更新后当前登录会话会失效，需要使用新密码重新登录。</view>
  </view>
</view>
