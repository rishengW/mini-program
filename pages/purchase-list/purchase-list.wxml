<!-- pages/purchase-list/purchase-list.wxml -->
<view class="container">
  <!-- P2-29：首屏数据未回时筛选条整行空白——tabs 就绪前不渲染空条 -->
  <view class="filter-bar" wx:if="{{filterTabs.length}}">
    <view wx:for="{{filterTabs}}" wx:key="value"
          class="filter-tab {{activeFilter === item.value ? 'filter-tab-active' : ''}}"
          bindtap="switchFilter" data-value="{{item.value}}">
      {{item.label}}
    </view>
  </view>

  <view wx:for="{{filteredList}}" wx:key="purchaseOrderId" class="list-item">
    <view class="flex-between" bindtap="goDetail" data-id="{{item.purchaseOrderId}}">
      <view class="item-title">{{item.orderDate}} 门店采购</view>
      <view class="tag tag-{{item.statusType}}">{{item.statusText}}</view>
    </view>
    <view class="item-products" bindtap="goDetail" data-id="{{item.purchaseOrderId}}">
      <text wx:for="{{item.items}}" wx:for-item="prod" wx:key="itemId" class="product-tag {{prod.isManual ? 'product-tag-manual' : ''}}">
        {{prod.productNameSnapshot}} ×{{prod.orderQty}}{{prod.isManual ? ' (手动)' : ''}}
      </text>
    </view>
    <view class="item-meta">
      <text>{{item.storeName}}</text>
      <text class="dot">·</text>
      <text>{{item.createdBy}}</text>
      <text class="dot">·</text>
      <text>{{item.timeAgo}}</text>
      <text wx:if="{{item.manualCount > 0}}" class="manual-count-tag">含{{item.manualCount}}个手动商品</text>
    </view>
    <!-- 直接收货按钮 -->
    <view wx:if="{{item.canReceive}}" class="receive-btn-row">
      <button class="btn btn-success btn-sm receive-btn" catchtap="goReceive" data-id="{{item.purchaseOrderId}}"><view class="icon icon-sm icon-inline icon-package-white"></view>去收货</button>
    </view>
  </view>

  <!-- P2-29：首屏加载中与空态/失败态互斥，不再同时闪现"暂无采购申请" -->
  <view wx:if="{{isLoading && filteredList.length === 0}}" class="empty-state">
    <view class="empty-state-text">加载中…</view>
  </view>
  <view wx:elif="{{loadFailed}}" class="empty-state">
    <view class="empty-state-icon icon icon-xxl icon-alert-danger"></view>
    <view class="empty-state-text">加载失败，请下拉重试</view>
  </view>
  <view wx:elif="{{filteredList.length === 0}}" class="empty-state">
    <view class="empty-state-icon icon icon-xxl icon-clipboard-grey"></view>
    <view class="empty-state-text">暂无采购申请</view>
  </view>

  <!-- 分页状态提示：上拉加载中 / 已加载全部 -->
  <view wx:if="{{filteredList.length > 0 && (isLoadingMore || !hasMore)}}" class="load-more-hint">
    {{isLoadingMore ? '正在加载…' : '没有更多了'}}
  </view>

  <view class="fab" bindtap="goCreate"><text>+</text></view>
</view>
