/* pages/report-list/report-list.wxss */

.report-page-header { margin-bottom: 20rpx; }
.report-page-header .more-link { color: var(--color-primary); font-size: 24rpx; }

.filter-section { margin-bottom: 16rpx; }

.type-tabs {
  display: flex;
  white-space: nowrap;
  padding-bottom: 8rpx;
}

.type-tab {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 14rpx 24rpx;
  margin-right: 12rpx;
  background: var(--color-white);
  border-radius: 32rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  flex-shrink: 0;
}

.type-tab-active {
  background: var(--color-primary);
  color: var(--color-white);
}

.date-filter {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.date-picker-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: var(--color-white);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.clear-date {
  font-size: 24rpx;
  color: var(--color-primary);
}

/* 报表卡片 */
.report-card {
  background: var(--color-white);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.report-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.report-type-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.report-version {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  background: var(--color-bg-grey);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.report-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.scope-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.scope-name {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 500;
  margin-left: 6rpx;
}

.report-date {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.report-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--color-divider);
}

/* .action-link 已上移到 app.wxss 全局定义（receive-list 等页面同样需要），此处不再重复 */
