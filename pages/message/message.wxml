<!-- pages/message/message.wxml -->
<view class="container">
  <view class="page-header">
    <view class="page-title">消息中心</view>
    <view wx:if="{{unreadCount > 0}}" class="mark-all-read" bindtap="markAllRead">全部已读</view>
  </view>

  <view wx:for="{{messages}}" wx:key="id" class="msg-item {{!item.read ? 'msg-unread' : ''}}" bindtap="readMessage" data-id="{{item.id}}">
    <view class="msg-icon-wrap">
      <view class="msg-icon">
        <view wx:if="{{item.type === 'approval'}}" class="icon icon-check-success"></view>
        <view wx:elif="{{item.type === 'order'}}" class="icon icon-package-primary"></view>
        <view wx:elif="{{item.type === 'receive'}}" class="icon icon-truck-primary"></view>
        <view wx:elif="{{item.type === 'abnormal'}}" class="icon icon-alert-danger"></view>
        <view wx:else class="icon icon-chat-grey"></view>
      </view>
      <view wx:if="{{!item.read}}" class="msg-dot"></view>
    </view>
    <view class="msg-content">
      <view class="msg-title">{{item.title}}</view>
      <view class="msg-body text-sm text-tertiary">{{item.content}}</view>
      <view class="msg-time text-sm text-tertiary">{{item.timeAgo}}</view>
    </view>
  </view>

  <view wx:if="{{messages.length === 0}}" class="empty-state">
    <view class="empty-state-icon icon icon-xxl icon-chat-grey"></view>
    <view class="empty-state-text">暂无消息</view>
  </view>
</view>
