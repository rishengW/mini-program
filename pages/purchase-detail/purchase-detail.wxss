/* pages/purchase-detail/purchase-detail.wxss */

.status-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  color: var(--color-white);
}

.status-bg-grey { background: linear-gradient(135deg, var(--color-text-tertiary), var(--color-text-secondary)); }
.status-bg-primary { background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary)); }
.status-bg-warning { background: linear-gradient(135deg, var(--color-warning-light-2), var(--color-warning)); }
.status-bg-success { background: linear-gradient(135deg, var(--color-success-light), var(--color-success)); }
.status-bg-danger { background: linear-gradient(135deg, var(--color-danger-light), var(--color-danger)); }

.status-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.status-text {
  font-size: 32rpx;
  font-weight: 600;
}

.status-reason {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.9;
  text-align: center;
}

/* 信息网格 */
.info-grid {
  display: flex;
  flex-wrap: wrap;
}

.info-item {
  width: 50%;
  margin-bottom: 20rpx;
}

.info-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 6rpx;
}

.info-value {
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.info-remark {
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-divider);
}

/* 供货商分组头（S6） */
.supplier-group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0 12rpx;
  border-bottom: 1rpx solid var(--color-border);
  margin-bottom: 4rpx;
}

/* 代确认入口（管理员）：供应商确认门禁的逃生通道 */
.proxy-confirm-link {
  font-size: 24rpx;
  color: var(--color-primary);
  text-decoration: underline;
  padding: 8rpx 0;
}

.supplier-group-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

/* 商品行 */
.goods-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.goods-row:last-child {
  border-bottom: none;
}

.goods-info {
  flex: 1;
}

.goods-name {
  font-size: 28rpx;
  font-weight: 500;
}

.goods-qty {
  text-align: right;
}

.qty-main {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.qty-approved {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.manual-badge {
  display: inline-block;
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  background: var(--color-warning-bg);
  color: var(--color-warning);
  margin-left: 6rpx;
  vertical-align: middle;
}

.manual-goods-row {
  border-left: 4rpx solid var(--color-warning);
  padding-left: 16rpx;
}

/* S9：凭证图片 */
.voucher-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.voucher-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--color-divider);
}

/* 底部操作 */
.bottom-actions {
  display: flex;
  gap: 20rpx;
  padding: 32rpx 0;
}
