<!-- pages/purchase-detail/purchase-detail.wxml -->
<view class="container">
  <view class="status-card status-bg-{{detail.statusType}}">
    <view class="status-icon">
      <view wx:if="{{detail.orderStatus === 'draft'}}" class="icon icon-xl icon-edit-white"></view>
      <view wx:elif="{{detail.orderStatus === 'submitted'}}" class="icon icon-xl icon-upload-white"></view>
      <view wx:elif="{{detail.orderStatus === 'received'}}" class="icon icon-xl icon-check-white"></view>
      <view wx:else class="icon icon-xl icon-clipboard-white"></view>
    </view>
    <view class="status-text">{{detail.statusText}}</view>
  </view>

  <view class="card">
    <view class="card-title">基本信息</view>
    <view class="info-grid">
      <view class="info-item">
        <view class="info-label">门店</view>
        <view class="info-value">{{detail.storeName}}</view>
      </view>
      <view class="info-item">
        <view class="info-label">下单日期</view>
        <view class="info-value">{{detail.orderDate}}</view>
      </view>
      <view class="info-item">
        <view class="info-label">期望到货</view>
        <view class="info-value">{{detail.deliveryDate || detail.orderDate}}</view>
      </view>
      <view class="info-item">
        <view class="info-label">提交人</view>
        <view class="info-value">{{detail.createdBy}}</view>
      </view>
      <view class="info-item">
        <view class="info-label">创建时间</view>
        <view class="info-value">{{detail.createdAt}}</view>
      </view>
    </view>
    <view wx:if="{{detail.remark}}" class="info-remark">
      <view class="info-label">备注</view>
      <view class="info-value">{{detail.remark}}</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">商品清单 ({{detail.items.length}})</view>
    <!-- 非 chef：按供货商分组，组头展示确认状态（S6） -->
    <block wx:if="{{supplierGroups}}">
      <block wx:for="{{supplierGroups}}" wx:for-item="group" wx:key="supplierId">
        <view class="supplier-group-header">
          <view class="supplier-group-name"><view class="icon icon-sm icon-inline icon-factory-grey"></view>{{group.supplierName}}</view>
          <text wx:if="{{group.confirmText}}" class="tag tag-{{group.confirmType}}">{{group.confirmText}}</text>
        </view>
        <view wx:for="{{group.items}}" wx:key="itemId" class="goods-row {{item.isManual ? 'manual-goods-row' : ''}}">
          <view class="goods-info">
            <view class="goods-name">
              {{item.productNameSnapshot}}
              <text wx:if="{{item.isManual}}" class="manual-badge">手动</text>
            </view>
            <view class="goods-spec text-sm text-tertiary">{{item.categorySnapshot}} · {{item.unitSnapshot}}</view>
          </view>
          <view class="goods-qty">
            <view class="qty-main">×{{item.orderQty}} {{item.unitSnapshot}}</view>
          </view>
        </view>
      </block>
    </block>
    <!-- chef：不见供应商身份，平铺 + 逐行标签 -->
    <block wx:else>
      <view wx:for="{{detail.items}}" wx:key="itemId" class="goods-row {{item.isManual ? 'manual-goods-row' : ''}}">
        <view class="goods-info">
          <view class="goods-name">
            {{item.productNameSnapshot}}
            <text wx:if="{{item.isManual}}" class="manual-badge">手动</text>
            <text wx:if="{{item.supplierConfirmText}}" class="tag tag-{{item.supplierConfirmType}}" style="margin-left:12rpx;">{{item.supplierConfirmText}}</text>
          </view>
          <view class="goods-spec text-sm text-tertiary">{{item.categorySnapshot}} · {{item.unitSnapshot}}</view>
        </view>
        <view class="goods-qty">
          <view class="qty-main">×{{item.orderQty}} {{item.unitSnapshot}}</view>
        </view>
      </view>
    </block>
  </view>

  <!-- S9：手动商品专用单——凭证核销状态与操作 -->
  <view wx:if="{{isManualOrder}}" class="card">
    <view class="card-title">付款核销</view>
    <view class="verify-status-row">
      <text>核销状态：</text>
      <text wx:if="{{verifyStatus === 'approved'}}" class="tag tag-success">已核销</text>
      <text wx:elif="{{verifyStatus === 'pending'}}" class="tag tag-warning">待核销（凭证已提交）</text>
      <text wx:elif="{{verifyStatus === 'rejected'}}" class="tag tag-danger">凭证被驳回，请重新提交</text>
      <text wx:elif="{{voucherBlockReason}}" class="tag tag-grey">暂不可提交凭证</text>
      <text wx:else class="tag tag-info">待提交凭证</text>
    </view>
    <!-- P0-7：静默不可达改为可解释阻塞——不可提交时必须给出原因 -->
    <view wx:if="{{voucherBlockReason}}" class="text-sm" style="margin-top:8rpx;color:#FF6B00;">{{voucherBlockReason}}</view>
    <view wx:if="{{voucherImages.length}}" class="voucher-list">
      <image wx:for="{{voucherImages}}" wx:key="*this" src="{{item}}" mode="aspectFill" class="voucher-img" bindtap="previewVoucher" data-index="{{index}}" />
    </view>
    <view wx:if="{{detail.verifyAmount}}" class="text-sm" style="margin-top:8rpx;">实付金额：¥{{detail.verifyAmount}}</view>
    <view wx:if="{{detail.verifyNote}}" class="text-sm text-tertiary" style="margin-top:8rpx;">备注：{{detail.verifyNote}}</view>
    <view wx:if="{{verifyStatus === 'rejected' && detail.verifyRejectNote}}" class="text-sm" style="margin-top:8rpx;color:#FF4D4F;">驳回原因：{{detail.verifyRejectNote}}</view>
  </view>

  <view wx:if="{{canEdit}}" class="bottom-actions">
    <button class="btn btn-outline flex-1" bindtap="editRequest">编辑</button>
    <button class="btn btn-primary flex-1" bindtap="submitRequest">提交审核</button>
  </view>

  <view wx:if="{{canCopy}}" class="bottom-actions">
    <button class="btn btn-outline btn-block" bindtap="copyToDraft"><view class="icon icon-sm icon-inline icon-file-primary"></view>复制为新草稿</button>
  </view>

  <view wx:if="{{canCancel}}" class="bottom-actions">
    <button class="btn btn-danger btn-block" bindtap="cancelOrder">作废</button>
  </view>

  <!-- #12-③：等待审核时下单人/店长可催办 -->
  <view wx:if="{{canRemindAudit}}" class="bottom-actions">
    <button class="btn btn-outline btn-block" bindtap="remindAudit"><view class="icon icon-sm icon-inline icon-bell-primary"></view>催促审核</button>
  </view>

  <view wx:if="{{canRequestCancel || canForceCancel}}" class="bottom-actions">
    <button wx:if="{{canRequestCancel}}" class="btn btn-outline btn-block" bindtap="requestCancel">申请取消</button>
    <button wx:if="{{canForceCancel}}" class="btn btn-danger btn-block" bindtap="cancelOrder">管理员作废</button>
  </view>

  <view wx:if="{{canReceive}}" class="bottom-actions">
    <button class="btn btn-success btn-block" bindtap="goReceive"><view class="icon icon-sm icon-inline icon-package-white"></view>去收货</button>
  </view>

  <!-- S9：手动单凭证操作 -->
  <view wx:if="{{canSubmitVoucher}}" class="bottom-actions">
    <button class="btn btn-primary btn-block" bindtap="submitVoucher"><view class="icon icon-sm icon-inline icon-receipt-white"></view>上传付款凭证</button>
  </view>
  <view wx:if="{{canVerify}}" class="bottom-actions">
    <button class="btn btn-outline flex-1" bindtap="verifyDecide" data-approve="false">驳回凭证</button>
    <button class="btn btn-primary flex-1" bindtap="verifyDecide" data-approve="true">核销通过</button>
  </view>
</view>
