/* pages/receive-verify/receive-verify.wxss */

.order-info { margin-top: 8rpx; }

.verify-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.verify-item:last-child { border-bottom: none; }

.verify-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.verify-product-name {
  font-size: 28rpx;
  font-weight: 600;
}

.verify-form {
  padding-left: 16rpx;
}

.verify-row {
  margin-bottom: 16rpx;
}

.verify-label {
  font-size: 24rpx;
  color: #8C8C8C;
  margin-bottom: 8rpx;
  display: block;
}

.verify-input-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.verify-input {
  width: 160rpx;
  height: 64rpx;
  background: #F0F2F5;
  border-radius: 8rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.verify-unit {
  font-size: 26rpx;
  color: #595959;
}

.check-group {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.check-item {
  padding: 8rpx 20rpx;
  background: #F0F2F5;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #595959;
  border: 2rpx solid transparent;
}

.check-active {
  background: #FFF2F0;
  color: #FF4D4F;
  border-color: #FF4D4F;
}

/* 照片 */
.photo-hint {
  margin: -8rpx 0 16rpx;
  color: #8C8C8C;
  font-size: 22rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-del {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #D9D9D9;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.photo-add-icon { font-size: 48rpx; }

.photo-add-text {
  font-size: 22rpx;
  color: #8C8C8C;
  margin-top: 4rpx;
}

/* 提交栏 */
.submit-bar {
  padding: 32rpx 0;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
