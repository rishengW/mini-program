/* pages/receive-verify/receive-verify.wxss */

.order-info { margin-top: 8rpx; }

/* P2-63：手动商品专用单提示条 */
.manual-order-banner {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: var(--color-warning-bg);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: var(--color-accent-orange);
}

/* 供应商确认门禁：未确认行的锁定呈现（与手动单提示条同色系，同属"流程阻断"语义） */
.pending-supplier-banner {
  margin-bottom: 16rpx;
  padding: 12rpx 16rpx;
  background: var(--color-warning-bg);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: var(--color-accent-orange);
}
.verify-item-locked .verify-form {
  opacity: 0.45;
}

.verify-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.verify-item:last-child { border-bottom: none; }

.verify-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.verify-product-name {
  font-size: 28rpx;
  font-weight: 600;
}

.verify-form {
  padding-left: 16rpx;
}

.verify-row {
  margin-bottom: 16rpx;
}

.verify-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 8rpx;
  display: block;
}

.verify-input-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.verify-input {
  width: 160rpx;
  height: 64rpx;
  background: var(--color-bg-grey);
  border-radius: 8rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.verify-unit {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.check-group {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.check-item {
  padding: 8rpx 20rpx;
  background: var(--color-bg-grey);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  border: 2rpx solid transparent;
}

.check-active {
  background: var(--color-danger-bg);
  color: var(--color-danger);
  border-color: var(--color-danger);
}

/* 照片 */
.photo-hint {
  margin: -8rpx 0 16rpx;
  color: var(--color-text-tertiary);
  font-size: 22rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-del {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  color: var(--color-white);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed var(--color-border-strong);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.photo-add-icon { font-size: 48rpx; }

.photo-add-text {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
}

/* 提交栏 */
.submit-bar {
  padding: 32rpx 0;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
