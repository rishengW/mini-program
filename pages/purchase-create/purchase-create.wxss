/* pages/purchase-create/purchase-create.wxss */
/* 重写：直接输入数量，滚动修复 */

.page-wrap {
  min-height: 100vh; background: var(--color-bg-page);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 顶部标题 */
.header-bar { padding: 20rpx 24rpx 12rpx; }
.header-title { font-size: 34rpx; font-weight: 700; }

/* L1分类Tab */
.l1-tabs { display: flex; padding: 8rpx 24rpx 12rpx; gap: 12rpx; }
.l1-tab {
  flex: 1; text-align: center; padding: 14rpx 0;
  border-radius: 10rpx; font-size: 28rpx; color: #595959;
  background: var(--color-bg-card); font-weight: 500;
  box-shadow: var(--shadow-card);
}
.l1-tab-active { background: var(--color-primary); color: #fff; }

/* 搜索 */
.search-section { padding: 0 24rpx 8rpx; }
.search-input {
  width: 100%; height: 68rpx; padding: 0 24rpx;
  background: var(--color-bg-card); border-radius: 34rpx;
  font-size: 26rpx; box-shadow: var(--shadow-card); box-sizing: border-box;
}

/* 二级分类横滚 */
.cat2-scroll { white-space: nowrap; padding: 4rpx 24rpx 12rpx; }
.cat2-item {
  display: inline-block; padding: 10rpx 20rpx;
  margin-right: 12rpx; border-radius: 24rpx; font-size: 24rpx;
  background: var(--color-bg-card); color: #595959;
  box-shadow: var(--shadow-card);
}
.cat2-item-active { background: var(--color-primary); color: #fff; }

/* 商品卡片区域 */
.product-section { padding: 0 24rpx; }
.product-card {
  background: var(--color-bg-card); border-radius: var(--radius-md);
  padding: 16rpx 20rpx; margin-bottom: 12rpx;
  box-shadow: var(--shadow-card);
  border-left: 4rpx solid transparent;
}
.product-card-active { border-left-color: var(--color-primary); background: rgba(24,144,255,0.03); }

.product-top { margin-bottom: 8rpx; }
.product-name-row { display: flex; align-items: baseline; gap: 8rpx; }
.product-name { font-size: 28rpx; font-weight: 600; color: #262626; }
.product-unit { font-size: 22rpx; color: #8C8C8C; }
.product-brand { font-size: 22rpx; color: #BFBFBF; margin-top: 2rpx; }

.product-bottom { display: flex; justify-content: flex-end; }

/* 数量控制 */
.qty-control { display: flex; align-items: center; }
.qty-btn {
  width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
  background: #F0F2F5; border-radius: 8rpx;
  font-size: 32rpx; color: #595959; font-weight: 600;
}
.qty-btn:active { background: #E0E2E5; }
.qty-input {
  width: 100rpx; height: 56rpx;
  text-align: center; font-size: 30rpx; font-weight: 600;
  margin: 0 8rpx; background: #F0F2F5; border-radius: 8rpx;
}

/* 区块卡片 */
.section-card {
  margin: 12rpx 24rpx; padding: 20rpx;
  background: var(--color-bg-card); border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
}
.section-title { font-size: 28rpx; font-weight: 600; }
.add-btn { color: var(--color-primary); font-size: 26rpx; font-weight: 500; }
.add-btn-disabled { color: #BFBFBF; }
.empty-hint { text-align: center; padding: 40rpx 0; color: #BFBFBF; font-size: 24rpx; }
.empty-hint-sm { text-align: center; padding: 16rpx 0; color: #BFBFBF; font-size: 22rpx; }

/* 手动商品行 */
.manual-row {
  display: flex; align-items: center; padding: 12rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}
.manual-row:last-child { border-bottom: none; }
.manual-info { flex: 1; }
.manual-name { font-size: 26rpx; font-weight: 500; }
.manual-badge {
  display: inline-block; font-size: 18rpx; padding: 2rpx 8rpx;
  border-radius: 4rpx; background: #FFF7E6; color: #FAAD14;
  margin-left: 6rpx; vertical-align: middle;
}
.manual-meta { display: block; font-size: 22rpx; color: #8C8C8C; margin-top: 2rpx; }
.qty-control-sm { display: flex; align-items: center; margin-right: 12rpx; }
.qty-btn-sm {
  width: 44rpx; height: 44rpx;
  display: flex; align-items: center; justify-content: center;
  background: #F0F2F5; border-radius: 6rpx; font-size: 28rpx; color: #595959;
}
.qty-input-sm {
  width: 64rpx; height: 44rpx; text-align: center;
  font-size: 26rpx; font-weight: 600; margin: 0 6rpx;
  background: #F0F2F5; border-radius: 6rpx;
}
.remove-btn { font-size: 26rpx; color: #BFBFBF; padding: 8rpx; }

/* 表单行 */
.form-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12rpx 0;
}
.form-row-label { font-size: 26rpx; color: #595959; }
.form-row-value { font-size: 28rpx; color: #262626; font-weight: 500; }

/* 备注 */
.remark-input {
  width: 100%; padding: 12rpx 16rpx;
  background: #F5F7FA; border-radius: 8rpx;
  font-size: 26rpx; box-sizing: border-box;
}

/* 底部提交栏 */
.submit-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06); z-index: 50;
}
.submit-info { font-size: 26rpx; color: #595959; }
.submit-btns { display: flex; gap: 12rpx; }

/* 弹窗 */
.picker-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 100;
  display: flex; justify-content: center; align-items: flex-end;
}
.manual-popup {
  width: 100%; background: #fff; border-radius: 24rpx 24rpx 0 0; max-height: 80vh;
}
.popup-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 32rpx; border-bottom: 1rpx solid #F0F0F0;
}
.popup-title { font-size: 32rpx; font-weight: 600; }
.popup-close { font-size: 36rpx; color: #8C8C8C; padding: 8rpx; }
.manual-form { padding: 20rpx 32rpx 40rpx; }
.manual-category-tabs { display: flex; gap: 16rpx; }
.manual-cat-tab {
  flex: 1; text-align: center; padding: 14rpx 0;
  border-radius: 10rpx; font-size: 28rpx;
  background: #F5F7FA; color: #595959; border: 2rpx solid transparent;
}
.manual-cat-active {
  border-color: var(--color-primary); background: rgba(24,144,255,0.06);
  color: var(--color-primary); font-weight: 600;
}
