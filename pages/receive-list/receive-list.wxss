/* pages/receive-list/receive-list.wxss */
.page-header { margin-bottom: 20rpx; }
.page-title { font-size: 34rpx; font-weight: 600; }

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.supplier-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #262626;
}

.order-no {
  margin-top: 8rpx;
}

.order-product {
  padding: 8rpx 0;
  font-size: 26rpx;
  color: #595959;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.delivery-info {
  color: #595959;
}

.order-amount {
  font-size: 28rpx;
}

.receipt-history { margin-top: 24rpx; }
.receipt-history-item { padding: 16rpx 0; border-bottom: 1rpx solid #F0F0F0; }
.receipt-history-item:last-child { border-bottom: none; }
.receipt-history-item > view:last-child { margin-top: 6rpx; }
