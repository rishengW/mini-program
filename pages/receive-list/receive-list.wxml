<!-- pages/receive-list/receive-list.wxml -->
<view class="container">
  <view class="page-header">
    <view class="page-title">待收货订单</view>
  </view>

  <view wx:for="{{orders}}" wx:key="purchaseOrderId" class="list-item" bindtap="goVerify" data-id="{{item.purchaseOrderId}}">
    <view class="order-header">
      <view class="supplier-name">{{item.storeName}} · {{item.orderDate}}</view>
      <view class="tag tag-{{item.statusType}}">{{item.statusText}}</view>
    </view>
    <view class="order-no text-sm text-tertiary">单号: {{item.orderNo}}</view>
    <view class="divider"></view>
    <view wx:for="{{item.items}}" wx:for-item="product" wx:key="itemId" class="order-product">
      <view class="flex-between">
        <text>{{product.productNameSnapshot}} {{product.isManual ? '(手动)' : ''}}</text>
        <text>×{{product.orderQty}} {{product.unitSnapshot}}</text>
      </view>
    </view>
    <view class="divider"></view>
    <view class="order-footer">
      <text class="text-sm">提交人: {{item.createdBy}}</text>
      <text class="text-sm">{{item.itemCount}}种商品</text>
    </view>
  </view>

  <view wx:if="{{orders.length === 0}}" class="empty-state">
    <view class="empty-state-icon">📦</view>
    <view class="empty-state-text">暂无待收货订单</view>
  </view>

  <view wx:if="{{receipts.length > 0}}" class="card receipt-history">
    <view class="card-title">最近收货记录</view>
    <view wx:for="{{receipts}}" wx:key="receiptId" class="receipt-history-item">
      <view class="flex-between">
        <text class="text-bold">{{item.storeName}} · {{item.receiptDate}}</text>
        <view class="flex-between" style="gap:12rpx;">
          <text class="tag tag-{{item.statusType}}">{{item.statusText}}</text>
          <text class="text-sm text-tertiary">{{item.items.length}}种商品</text>
        </view>
      </view>
      <view class="flex-between" style="margin-top:8rpx;">
        <view class="text-sm text-tertiary">
          收货人: {{item.receivedBy}}
          <text wx:if="{{item.missingReports}}" class="tag tag-danger" style="margin-left:8rpx;">缺报表</text>
          <text wx:if="{{item.hasMissingPrice}}" class="tag tag-warning" style="margin-left:8rpx;">缺价待补</text>
        </view>
        <view style="display:flex;gap:16rpx;">
          <text wx:if="{{item.photoCount > 0}}" class="action-link" catchtap="previewReceiptPhotos" data-index="{{index}}">照片({{item.photoCount}})</text>
          <text wx:if="{{item.missingReports && canRegenerate}}" class="action-link" catchtap="regenerateReports" data-index="{{index}}">补生成</text>
          <text wx:if="{{item.hasMissingPrice && canReprice}}" class="action-link" catchtap="repriceReceipt" data-id="{{item.receiptId}}">补价补账</text>
          <text wx:if="{{item.hasAbnormal}}" class="action-link" catchtap="settleReceipt" data-index="{{index}}">补结算</text>
        </view>
      </view>
    </view>
  </view>
</view>
