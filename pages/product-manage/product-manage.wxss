/* pages/product-manage/product-manage.wxss */
.page-header { margin-bottom: 24rpx; }
.page-title { font-size: 36rpx; font-weight: 700; }
.page-subtitle { font-size: 24rpx; color: var(--color-text-tertiary); margin-top: 4rpx; }

.search-bar { margin-bottom: 20rpx; }
.search-input {
  width: 100%; height: 76rpx; padding: 0 24rpx;
  background: var(--color-bg-card); border-radius: var(--radius-lg);
  font-size: 28rpx; box-shadow: var(--shadow-card); box-sizing: border-box;
}

.filter-bar { display: flex; gap: 12rpx; margin-bottom: 24rpx; flex-wrap: wrap; }
.filter-tab {
  padding: 12rpx 24rpx; border-radius: 32rpx; font-size: 24rpx;
  background: var(--color-bg-card); color: var(--color-text-secondary); box-shadow: var(--shadow-card);
}
.filter-tab-active { background: var(--color-primary); color: #fff; }

.item-name { font-size: 30rpx; font-weight: 600; display: flex; align-items: center; }
.item-meta { font-size: 24rpx; color: var(--color-text-tertiary); margin-top: 8rpx; }
.item-sub { font-size: 22rpx; color: var(--color-text-tertiary); margin-top: 4rpx; }
.item-actions { display: flex; gap: 16rpx; }
.action-btn { font-size: 36rpx; padding: 8rpx; }

.fab {
  position: fixed; right: 40rpx; bottom: 120rpx;
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff; font-size: 44rpx; display: flex; align-items: center; justify-content: center;
  box-shadow: var(--shadow-float);
}
.fab:active { transform: scale(0.92); }

.modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 1000;
  display: flex; align-items: flex-end; justify-content: center;
}
.modal-body {
  width: 100%; max-height: 85vh; padding: 40rpx;
  background: #fff; border-radius: 24rpx 24rpx 0 0;
  overflow-y: auto; box-sizing: border-box;
}
.modal-title { font-size: 34rpx; font-weight: 700; margin-bottom: 32rpx; text-align: center; }
.picker-display { display: flex; align-items: center; line-height: 80rpx; }
