/* pages/login/login.wxss */

.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1890FF 0%, #096DD9 40%, #F5F7FA 40%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-header {
  padding-top: 120rpx;
  text-align: center;
  color: #ffffff;
}

.login-logo {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.login-title {
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.login-subtitle {
  font-size: 26rpx;
  opacity: 0.85;
}

.login-card {
  width: 88%;
  margin-top: 60rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 36rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.1);
}

.login-card-title {
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 40rpx;
  color: #262626;
}

.role-section {
  margin-bottom: 32rpx;
}

.role-list {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.role-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  border-radius: 16rpx;
  border: 2rpx solid #E8E8E8;
  background: #ffffff;
  transition: all 0.2s;
}

.role-item-active {
  border-color: #1890FF;
  background: rgba(24, 144, 255, 0.06);
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.15);
}

.role-icon {
  font-size: 52rpx;
  margin-bottom: 12rpx;
}

.role-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #262626;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 26rpx;
  color: #595959;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.login-btn {
  margin-top: 48rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  border-radius: 16rpx;
}

.history-card {
  width: 88%;
  margin-top: 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.history-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #262626;
  margin-bottom: 24rpx;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}
.history-item:last-child {
  border-bottom: none;
}

.history-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.history-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #1890FF;
  color: #ffffff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-weight: 600;
}

.history-detail {
  flex: 1;
}

.history-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #262626;
}

.history-role {
  font-size: 20rpx;
  color: #8C8C8C;
  background: #F5F7FA;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-left: 8rpx;
}

.history-username {
  font-size: 24rpx;
  color: #8C8C8C;
  margin-top: 4rpx;
}

.history-close {
  padding: 10rpx;
  color: #BFBFBF;
  font-size: 32rpx;
}

.login-footer {
  margin-top: auto;
  padding-bottom: 60rpx;
  padding-top: 40rpx;
}
