/* pages/login/login.wxss */

.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #00873E 0%, #006B33 40%, #F5F7FA 40%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-header {
  padding-top: 24rpx;
  text-align: center;
  color: #ffffff;
}

.login-logo {
  width: 124rpx;
  height: 124rpx;
  border-radius: 16rpx;
  background: #ffffff;
  padding: 8rpx;
  margin-bottom: 8rpx;
}

.login-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.login-card {
  width: 88%;
  margin-top: 12rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 30rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.1);
}

.login-card-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 10rpx;
  color: #262626;
}

/* 角色区：两行两列，按钮整体放大，方便年纪较大的供货商辨认 */
.role-section {
  margin-bottom: 16rpx;
}

.role-caption {
  font-size: 26rpx;
  color: #595959;
  text-align: center;
  margin-bottom: 8rpx;
}

/* 固定列宽并整体居中：1fr 满宽会把按钮拉得又扁又宽，"采购主管"四字两侧空一大片 */
.role-list {
  display: grid;
  grid-template-columns: repeat(2, 240rpx);
  gap: 20rpx;
  justify-content: center;
}

.role-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 0;
  border-radius: 16rpx;
  border: 2rpx solid #E8E8E8;
  background: #ffffff;
  transition: all 0.2s;
}

.role-item-active {
  border-color: #00873E;
  background: rgba(0, 135, 62, 0.06);
  box-shadow: 0 4rpx 16rpx rgba(0, 135, 62, 0.15);
}

/* 图标尺寸：比 .icon 基类更具体，确保覆盖 app.wxss 里的 40rpx */
.role-item .icon {
  width: 64rpx;
  height: 64rpx;
}

.role-icon {
  margin-bottom: 12rpx;
  flex-shrink: 0;
}

.role-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #262626;
  line-height: 1.3;
  white-space: nowrap;
}

.form-group {
  margin-bottom: 16rpx;
}

.form-label {
  font-size: 28rpx;
  color: #595959;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  height: 92rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  box-sizing: border-box;
}

.login-btn {
  margin-top: 4rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 34rpx;
  border-radius: 16rpx;
}

.login-alt {
  text-align: center;
  margin-top: 24rpx;
}

.login-alt-green {
  color: #00873E;
  font-size: 28rpx;
}

.login-alt-grey {
  color: #8C8C8C;
  font-size: 28rpx;
}

.history-card {
  width: 88%;
  margin-top: 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.history-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #262626;
  margin-bottom: 24rpx;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}
.history-item:last-child {
  border-bottom: none;
}

.history-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.history-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #00873E;
  color: #ffffff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-weight: 600;
}

.history-detail {
  flex: 1;
}

.history-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #262626;
}

.history-role {
  font-size: 20rpx;
  color: #8C8C8C;
  background: #F5F7FA;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-left: 8rpx;
}

.history-username {
  font-size: 24rpx;
  color: #8C8C8C;
  margin-top: 4rpx;
}

.history-close {
  padding: 10rpx;
  color: #BFBFBF;
  font-size: 32rpx;
}

.login-footer {
  margin-top: auto;
  padding-bottom: 36rpx;
  padding-top: 20rpx;
}
