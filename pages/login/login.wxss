/* pages/login/login.wxss */

.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--color-primary) 0%, var(--color-primary-dark) 40%, var(--color-bg-page) 40%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* header 占满顶部绿色区域（与背景渐变 40% 对齐）并垂直居中，
   避免 logo+标题贴顶、下方绿底空一大块 */
.login-header {
  height: 40vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: var(--color-white);
}

.login-logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: var(--color-white);
  padding: 8rpx;
  margin-bottom: 40rpx;
}

.login-title {
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.login-card {
  width: 88%;
  /* 卡片在 header 与 footer 之间垂直居中，避免下方大片留白 */
  margin-top: auto;
  margin-bottom: auto;
  background: var(--color-white);
  border-radius: 24rpx;
  padding: 24rpx 30rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.1);
  /* 裁掉滑出视口的面板，配合圆角 */
  overflow: hidden;
}

/* 角色面板卡片：撑满 header 与 footer 之间的纵向空间，
   2×2 角色按钮随之放大填满，消除卡片上下的灰色留白。
   超管登录作为滑块内的覆盖层，同样使用此撑满卡片。 */
.login-card--fill {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-top: 20rpx;
  margin-bottom: 20rpx;
}
.login-card--fill .login-slider {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.login-card--fill .login-slider-track {
  flex: 1;
}

.login-card-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 10rpx;
  color: var(--color-text-primary);
}

/* 水平滑动切换：轨道里两个面板并排，整体宽 200%
   点击角色后向左平移 50%（即一个面板宽），按钮移出、输入栏滑入 */
.login-slider {
  width: 100%;
  overflow: hidden;
  /* 超管层以此为定位参照 */
  position: relative;
}

.login-slider-track {
  display: flex;
  width: 200%;
  transition: transform 0.32s ease;
}

.login-slider-track.track-shifted {
  transform: translateX(-50%);
}

.login-panel {
  width: 50%;
  flex-shrink: 0;
  box-sizing: border-box;
  /* 纵向：角色面板靠按钮区 flex:1 填满、超管链接沉底；
     表单面板内容居中，避免卡片撑高后下方留白 */
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* 角色入口：2x2 方块网格，图标在上、角色名在下。
   flex:1 + rows 1fr 让两行均分面板高度，按钮填满按钮区域
   （卡片 --fill 后随视口撑高，不再封顶）。
   左右内边距 8rpx + 按钮 border-box：确保滑出后按钮边框落在面板内侧、
   被卡片 overflow:hidden 裁掉，不在输入栏页面边缘露边 */
.role-entry-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-template-rows: repeat(2, 1fr);
  gap: 20rpx;
  flex: 1;
  padding: 0 8rpx;
}

.role-entry {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  border-radius: 16rpx;
  border: 2rpx solid var(--color-border);
  background: var(--color-white);
  box-sizing: border-box;
  transition: all 0.2s;
}

.role-entry-active {
  border-color: var(--color-primary);
  background: rgba(0, 135, 62, 0.06);
  box-shadow: 0 4rpx 16rpx rgba(0, 135, 62, 0.15);
}

/* 图标尺寸：比 .icon 基类更具体，确保覆盖 app.wxss 里的 40rpx */
.role-entry .icon {
  width: 64rpx;
  height: 64rpx;
}

.role-entry-icon {
  margin-bottom: 12rpx;
  flex-shrink: 0;
}

.role-entry-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.3;
  white-space: nowrap;
}

/* 表单主体：撑满面板上半区并纵向居中，「返回选择角色」沉底 */
.login-form-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* 超管登录层：绝对定位铺满滑块，默认停在右侧视口外，
   切到超管时 translateX(0) 滑入盖住角色面板，
   返回时滑回右侧 —— 与角色面板的横向切换同一套动效 */
.superadmin-layer {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  background: var(--color-white);
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.32s ease, visibility 0s linear 0.32s;
  /* 层级盖住轨道，避免滑动过程中底层按钮露出来 */
  z-index: 2;
  /* 收起时隐藏整层（含输入框），滑出动画结束后才真正隐藏 */
  visibility: hidden;
}

.superadmin-layer-show {
  transform: translateX(0);
  visibility: visible;
  transition: transform 0.32s ease, visibility 0s;
}

.login-form-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-primary);
  text-align: center;
  margin-bottom: 16rpx;
}

.form-group {
  margin-bottom: 16rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  height: 92rpx;
  background: var(--color-bg-page);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  box-sizing: border-box;
}

.login-btn {
  margin-top: 4rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 34rpx;
  border-radius: 32rpx;
}

.login-back {
  text-align: center;
  margin-top: 20rpx;
}

.login-back-text {
  color: var(--color-text-tertiary);
  font-size: 28rpx;
}

/* 超管入口与「返回选择角色」拉开间距并加分隔线，避免误点 */
.login-alt {
  text-align: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--color-divider);
}

.login-alt-green {
  color: var(--color-primary);
  font-size: 28rpx;
}

.login-alt-grey {
  color: var(--color-text-tertiary);
  font-size: 28rpx;
}

.login-footer {
  /* 由 login-card 的 margin-bottom:auto 把 footer 推到底，这里不再顶底 */
  padding-bottom: 36rpx;
  padding-top: 20rpx;
}
