/* pages/login/login.wxss */

.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #00873E 0%, #006B33 40%, #F5F7FA 40%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* header 占满顶部绿色区域（与背景渐变 40% 对齐）并垂直居中，
   避免 logo+标题贴顶、下方绿底空一大块 */
.login-header {
  height: 40vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #ffffff;
}

.login-logo {
  width: 124rpx;
  height: 124rpx;
  border-radius: 16rpx;
  background: #ffffff;
  padding: 8rpx;
  margin-bottom: 8rpx;
}

.login-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.login-card {
  width: 88%;
  /* 卡片在 header 与 footer 之间垂直居中，避免下方大片留白 */
  margin-top: auto;
  margin-bottom: auto;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 30rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.1);
  /* 裁掉滑出视口的面板，配合圆角 */
  overflow: hidden;
}

.login-card-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 10rpx;
  color: #262626;
}

/* 水平滑动切换：轨道里两个面板并排，整体宽 200%
   点击角色后向左平移 50%（即一个面板宽），按钮移出、输入栏滑入 */
.login-slider {
  width: 100%;
  overflow: hidden;
}

.login-slider-track {
  display: flex;
  width: 200%;
  transition: transform 0.32s ease;
}

.login-slider-track.track-shifted {
  transform: translateX(-50%);
}

.login-panel {
  width: 50%;
  flex-shrink: 0;
  box-sizing: border-box;
  /* 让面板内子元素可纵向撑满：按钮区 flex:1 填满，消除下方留白 */
  display: flex;
  flex-direction: column;
}

/* 角色入口：2x2 方块网格，图标在上、角色名在下。
   flex:1 + rows 1fr 让两行均分面板高度，按钮填满按钮区域。
   max-height 兜底：防止另一侧面板内容变高时把按钮拉得过高。
   左右内边距 8rpx + 按钮 border-box：确保滑出后按钮边框落在面板内侧、
   被卡片 overflow:hidden 裁掉，不在输入栏页面边缘露边 */
.role-entry-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-template-rows: repeat(2, 1fr);
  gap: 20rpx;
  flex: 1;
  padding: 0 8rpx;
}

.role-entry {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  max-height: 280rpx;
  padding: 24rpx 0;
  border-radius: 16rpx;
  border: 2rpx solid #E8E8E8;
  background: #ffffff;
  box-sizing: border-box;
  transition: all 0.2s;
}

.role-entry-active {
  border-color: #00873E;
  background: rgba(0, 135, 62, 0.06);
  box-shadow: 0 4rpx 16rpx rgba(0, 135, 62, 0.15);
}

/* 图标尺寸：比 .icon 基类更具体，确保覆盖 app.wxss 里的 40rpx */
.role-entry .icon {
  width: 64rpx;
  height: 64rpx;
}

.role-entry-icon {
  margin-bottom: 12rpx;
  flex-shrink: 0;
}

.role-entry-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #262626;
  line-height: 1.3;
  white-space: nowrap;
}

.login-form-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #00873E;
  text-align: center;
  margin-bottom: 16rpx;
}

.form-group {
  margin-bottom: 16rpx;
}

.form-label {
  font-size: 28rpx;
  color: #595959;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  height: 92rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  box-sizing: border-box;
}

.login-btn {
  margin-top: 4rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 34rpx;
  border-radius: 16rpx;
}

.login-back {
  text-align: center;
  margin-top: 20rpx;
}

.login-back-text {
  color: #8C8C8C;
  font-size: 28rpx;
}

/* 超管入口与「返回选择角色」拉开间距并加分隔线，避免误点 */
.login-alt {
  text-align: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F0F0;
}

.login-alt-green {
  color: #00873E;
  font-size: 28rpx;
}

.login-alt-grey {
  color: #8C8C8C;
  font-size: 28rpx;
}

.login-footer {
  /* 由 login-card 的 margin-bottom:auto 把 footer 推到底，这里不再顶底 */
  padding-bottom: 36rpx;
  padding-top: 20rpx;
}
