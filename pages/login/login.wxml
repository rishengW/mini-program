<!-- pages/login/login.wxml -->
<view class="login-page">
  <view class="login-header">
    <image class="login-logo" src="/assets/icons/login-logo.jpg" mode="aspectFit" />
    <view class="login-title">门店采购系统</view>
  </view>

  <view class="login-card">
    <block wx:if="{{!isSuperAdminLogin}}">
      <view class="login-card-title">欢迎使用</view>

      <!-- 角色二选二：供货商等使用者年龄偏大，按钮放大并排成两行 -->
      <view class="role-section">
        <view class="role-caption">选择登录角色</view>
        <view class="role-list">
          <view wx:for="{{roles}}" wx:key="key"
            class="role-item {{selectedRole === item.key ? 'role-item-active' : ''}}"
            bindtap="selectRole" data-role="{{item.key}}">
            <view class="role-icon icon {{item.iconClass}}"></view>
            <view class="role-name">{{item.label}}</view>
          </view>
        </view>
      </view>

      <view class="form-group">
        <view class="form-label">账号</view>
        <input class="form-input" placeholder="请输入账号" value="{{username}}" bindinput="onInput" data-field="username" cursor-spacing="{{cursorSpacing}}" />
      </view>

      <view class="form-group">
        <view class="form-label">密码</view>
        <input class="form-input" password placeholder="请输入密码" value="{{password}}" bindinput="onInput" data-field="password" cursor-spacing="{{cursorSpacing}}" />
      </view>

      <button class="btn btn-primary btn-block login-btn" bindtap="login">进入系统</button>

      <view class="login-alt" bindtap="toggleSuperAdmin">
        <text class="login-alt-green">超级管理员登录</text>
      </view>
    </block>

    <block wx:else>
      <view class="login-card-title">超级管理员登录</view>

      <view class="form-group">
        <view class="form-label">超级账号</view>
        <input class="form-input" placeholder="请输入超级管理员账号" value="{{username}}" bindinput="onInput" data-field="username" cursor-spacing="{{cursorSpacing}}" />
      </view>

      <view class="form-group">
        <view class="form-label">密码</view>
        <input class="form-input" password placeholder="请输入密码" value="{{password}}" bindinput="onInput" data-field="password" cursor-spacing="{{cursorSpacing}}" />
      </view>

      <button class="btn btn-primary btn-block login-btn" bindtap="login">安全登录</button>

      <view class="login-alt" bindtap="toggleSuperAdmin">
        <text class="login-alt-grey">返回普通角色登录</text>
      </view>
    </block>
  </view>

  <view class="login-footer">
    <text class="text-tertiary text-sm">门店采购系统</text>
  </view>
</view>
