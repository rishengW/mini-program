/* pages/store-switch/store-switch.wxss */

.page-desc {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 24rpx;
}

.store-card {
  background: var(--color-white);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  border: 2rpx solid transparent;
}

.store-card-active {
  border-color: var(--color-primary);
  background: rgba(0, 135, 62, 0.03);
}

.store-card-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.store-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.store-content {
  flex: 1;
}

.store-card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.store-card-code {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
}

.current-badge {
  background: var(--color-primary);
  color: var(--color-white);
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.store-card-info {
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-divider);
}

.info-row {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.info-label {
  margin-right: 8rpx;
}
