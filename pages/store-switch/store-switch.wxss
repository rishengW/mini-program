/* pages/store-switch/store-switch.wxss */

.page-desc {
  font-size: 26rpx;
  color: #8C8C8C;
  margin-bottom: 24rpx;
}

.store-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  border: 2rpx solid transparent;
}

.store-card-active {
  border-color: #1890FF;
  background: rgba(24, 144, 255, 0.03);
}

.store-card-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.store-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.store-content {
  flex: 1;
}

.store-card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #262626;
}

.store-card-code {
  font-size: 22rpx;
  color: #8C8C8C;
  margin-top: 4rpx;
}

.current-badge {
  background: #1890FF;
  color: #ffffff;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.store-card-info {
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.info-row {
  font-size: 24rpx;
  color: #595959;
  margin-bottom: 8rpx;
}

.info-label {
  margin-right: 8rpx;
}

.add-store-btn {
  margin-top: 12rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #1890FF;
  background: #ffffff;
  border: 2rpx dashed #1890FF;
  border-radius: 16rpx;
}

.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 600rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #262626;
  text-align: center;
  margin-bottom: 32rpx;
}

.form-field {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #595959;
  display: block;
  margin-bottom: 12rpx;
}

.form-input {
  border: 2rpx solid #D9D9D9;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}

.form-hint {
  font-size: 24rpx;
  color: #8C8C8C;
  margin-bottom: 24rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.modal-btn-secondary {
  background: #F5F5F5;
  color: #595959;
}

.modal-btn-primary {
  background: #1890FF;
  color: #ffffff;
}
