<!-- pages/supplier-prices/supplier-prices.wxml -->
<view class="container">
  <view class="card hint-card">
    <text class="text-sm text-tertiary">以下为当前生效的协议价格，如需调整请联系采购方。</text>
  </view>

  <view wx:for="{{prices}}" wx:key="price_id" class="list-item">
    <view class="flex-between">
      <text class="price-product">{{item.product_name}}</text>
      <text class="price-value">{{item.priceText}}<text class="text-sm text-tertiary"> / {{item.unit || '单位'}}</text></text>
    </view>
    <view class="text-sm text-tertiary" style="margin-top:8rpx;">自 {{item.effective_date}} 起生效</view>
  </view>

  <view wx:if="{{prices.length === 0 && !loading}}" class="empty-state">
    <view class="empty-state-icon">💰</view>
    <view class="empty-state-text">暂无生效中的协议价格</view>
  </view>
</view>
